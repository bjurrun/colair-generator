---
// The demo page around the generator: a slim top bar (hidden on a phone, where the generator has its own toolbar),
// the generator itself, and a footer with the languages and the source. Replace this file with your own page;
// see docs/USING.md.
import '../styles/page.css';
import Icons from '../generator/Icons.astro';
import Generator, { type GeneratorText } from '../generator/Generator.astro';
import nl from '../text/nl.json';
import en from '../text/en.json';
import es from '../text/es.json';

export type Lang = 'en' | 'nl' | 'es';
interface Props { lang: Lang }
const { lang } = Astro.props;
const texts = { en, nl, es } as unknown as Record<Lang, GeneratorText & { meta: { titel: string; beschrijving: string } }>;
const text = texts[lang];
const LANGS: { id: Lang; path: string; name: string }[] = [
  { id: 'en', path: '/', name: 'English' },
  { id: 'nl', path: '/nl/', name: 'Nederlands' },
  { id: 'es', path: '/es/', name: 'Español' },
];
const REPO = 'https://github.com/bjurrun/colair-generator';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{text.meta.titel}</title>
<meta name="description" content={text.meta.beschrijving}>
</head>
<body class="maak-page">
<Icons />
<header class="top">
  <div class="wrap top-row">
    <a class="brand" href={LANGS.find((l) => l.id === lang)!.path}><img src="/assets/colair-logo.svg" alt="Colair" width="82" height="28"><span>generator</span></a>
    <nav class="langs" aria-label="Language">
      {LANGS.map((l) => <a href={l.path} aria-current={l.id === lang ? 'page' : undefined} hreflang={l.id}>{l.id.toUpperCase()}</a>)}
    </nav>
    <a class="source" href={REPO} aria-label="GitHub"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg></a>
  </div>
</header>

<Generator text={text}>
  <footer slot="voet" class="wrap page-foot">
    <p>Colair generator · <a href={REPO}>Source on GitHub</a> (MIT) · <a href="https://colair.app">colair.app</a></p>
    <nav aria-label="Language">{LANGS.map((l) => <a href={l.path} aria-current={l.id === lang ? 'page' : undefined} hreflang={l.id}>{l.name}</a>)}</nav>
  </footer>
</Generator>

<script>import '../generator/generator.ts';</script>
</body>
</html>
