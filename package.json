{
  "name": "colair-generator",
  "version": "1.0.0",
  "description": "The colour palette engine and web generator of the Colair app: harmonies, locking, warmer and cooler, colour names, palettes from a picture or a colour, and exports for Procreate and Adobe.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjurrun/colair-generator.git"
  },
  "homepage": "https://colair.app/generator/",
  "keywords": [
    "color",
    "colour",
    "palette",
    "generator",
    "harmony",
    "oklab",
    "procreate",
    "ase"
  ],
  "exports": {
    "./engine": "./src/kit/index.ts",
    "./engine/*": "./src/kit/*.ts",
    "./Generator.astro": "./src/generator/Generator.astro",
    "./Icons.astro": "./src/generator/Icons.astro",
    "./generator": "./src/generator/generator.ts",
    "./text/*": "./src/text/*"
  },
  "files": [
    "src",
    "public",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "astro": "^7.4.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
